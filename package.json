{
  "name": "payroll-tax-engine",
  "version": "0.1.0",
  "description": "Gross-to-net US payroll tax engine. Effective-dated data, per-tax taxable wage bases.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test tests/engine.test.ts tests/harvester.test.ts tests/geocode.test.ts tests/alabama.test.ts tests/harvest-sweep.test.ts tests/harvest-journal.test.ts tests/garnishment.test.ts",
    "demo": "node examples/demo.ts",
    "demo:garnishment": "node examples/garnishment-demo.ts",
    "demo:alabama": "node examples/alabama-demo.ts",
    "alabama": "node examples/alabama-calc.ts",
    "ui:alabama": "node examples/alabama-server.ts",
    "ui:calculator": "node examples/calculator-server.ts",
    "demo:harvest": "node examples/harvest-demo.ts",
    "demo:geocode": "node examples/geocode-demo.ts",
    "coverage:geocode": "node examples/geocode-coverage.ts",
    "coverage:taxes": "node examples/tax-coverage.ts",
    "coverage:local": "node examples/local-tax-smoke-test.ts",
    "harvest": "node examples/harvest-sweep.ts",
    "harvest:daily": "node examples/harvest-daily.ts daily",
    "harvest:status": "node examples/harvest-daily.ts status",
    "harvest:ack": "node examples/harvest-daily.ts ack",
    "harvest:diff": "node examples/harvest-daily.ts diff",
    "harvest:audit": "node examples/harvest-daily.ts audit",
    "edge:build": "node scripts/build-edge-function.ts && node scripts/build-data-bundle.ts",
    "edge:key": "node scripts/generate-api-key.ts"
  },
  "license": "MIT"
}
