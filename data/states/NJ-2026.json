  "exemptPretax": [],
  "exemptPretaxResolved": "RESOLVED: New Jersey Gross Income Tax is well-established as NOT conforming to federal pretax treatment for 401(k)/cafeteria-125-style deferrals -- NJ taxes those contributions as earned, the same \"taxes deferrals when earned\" rule this project already documents for Pennsylvania (see README). An empty exemptPretax array (full gross wages as the base) is therefore correct, not a placeholder.",
  "reciprocity": {
    "reciprocalStates": [
      "PA"
    ],
    "note": "New Jersey and Pennsylvania have a long-standing bilateral reciprocal agreement (in effect continuously since 1977) under which neither state withholds income tax from the other's residents working there. Not independently re-confirmed against a 2026-dated primary notice this session -- carried forward as a well-established, rarely-changing fact rather than freshly re-sourced, disclosed as a thinner evidentiary tier than this file's other figures."
  },
  "stateUnemploymentEmployee": {
    "rate": 0.00425,
    "wageBase": 44800,
    "$comment": "Combined employee UI (0.3825%) + Workforce Development/Supplemental Workforce Fund (0.0425%) contribution, reported together as one line on NJ payroll (NJ-927) -- modeled as a single rate rather than two separate TaxLines since both share the exact same wage base and YTD tracker, and no employer-facing document treats them as separable withholding lines the way NY splits PFL from DBL."
  },
  "stateDisabilityEmployee": {
    "rate": 0.0019,
    "wageBase": 171100,
    "$comment": "Temporary Disability Insurance (TDI), state plan. Uses the wageBase (annual, YTD-tracked) branch of stateDisabilityEmployeeTax(), NOT New York DBL's per-period weeklyCapDollars branch -- NJ TDI is an ordinary annual wage-base cap, structurally identical to statePaidLeaveEmployee's mechanism."
  },
  "statePaidLeaveEmployee": {
