node_modules/

# harvester/snapshots and harvester/review are regenerated on every test
# run (tests/harvester.test.ts's before() hook deletes and recreates both
# entirely) and embed the machine's own absolute filesystem path in each
# .raw.meta.json -- not reproducible across clones/machines, so they don't
# belong in version control. See tests/harvester.test.ts.
harvester/snapshots/
harvester/review/

# harvester/state is the monitor's own runtime memory -- the append-only
# event log (what ran, what changed, what was acknowledged) and the sweep
# lock. Same reasoning as the two above: it records what THIS machine
# observed and when, embeds absolute paths in snapshot references, and is
# rebuilt by running the sweep. Committing it would mean one machine's
# findings appearing as another's history. See harvester/journal.ts.
harvester/state/

# Supabase CLI's own local scratch state (linked project ref cache, CLI
# version pin) -- machine-local, not project configuration.
supabase/.temp/

# site/.data is the docs/console demo's own runtime store (leads,
# sessions, issued keys, usage log) -- this machine's local test data,
# not project configuration. See site/lib/store.ts.
site/.data/


# OpenAddresses bulk extracts — ~5GB, re-downloadable from data.openaddresses.io.
# Never committed: it is upstream data, not this project's own.
data/address-points/raw/

# The National Address Database's own bulk text-file export (~7.6GB
# zipped) — re-downloadable from transportation.gov/gis/national-address-
# database. Same reasoning as raw/ above: upstream data, not ours.
data/address-points/nad-raw/

# The built local address index itself (scripts/build-address-index.ts's
# output) — tens of GB once fully built. A derived artifact rebuilt from
# raw/ on demand, not this project's own data, and the WAL/SHM sidecar
# files SQLite leaves behind mid-build are transient too.
data/address-points/address-points.db
data/address-points/address-points.db-wal
data/address-points/address-points.db-shm
